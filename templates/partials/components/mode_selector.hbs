<div class="settings-block" data-component="mode-selector">
  <span class="settings-block__label" id="mode-selector-label">Test mode</span>
  <div class="segmented" role="radiogroup" aria-labelledby="mode-selector-label">
    <label class="segmented__option">
      <input type="radio" name="testMode" value="words" checked>
      <span class="segmented__text">Words</span>
    </label>
    <label class="segmented__option">
      <input type="radio" name="testMode" value="timed30">
      <span class="segmented__text">30 sec</span>
    </label>
    <label class="segmented__option">
      <input type="radio" name="testMode" value="timed60">
      <span class="segmented__text">60 sec</span>
    </label>
  </div>
</div>
