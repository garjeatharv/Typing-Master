<div class="settings-block" data-component="typing-behavior-selector">
  <span class="settings-block__label" id="typing-behavior-label">Mistakes</span>
  <div class="segmented segmented--two" role="radiogroup" aria-labelledby="typing-behavior-label">
    <label class="segmented__option">
      <input type="radio" name="typingBehavior" value="strict">
      <span class="segmented__text">Stop on error</span>
    </label>
    <label class="segmented__option">
      <input type="radio" name="typingBehavior" value="forgiving" checked>
      <span class="segmented__text">Keep typing</span>
    </label>
  </div>
  <p class="settings-block__hint">Stop on error blocks wrong keys. Keep typing marks mistakes and moves on.</p>
</div>
