<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle }} · TypingMaster</title>
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/practice-settings.css?v=inline-checkboxes">
  <link rel="stylesheet" href="/css/practice.css">
</head>
<body>
  {{> app_nav }}
  <main class="practice-page container" id="practice-page">
    <header class="practice-page__header">
      <div class="practice-page__header-row">
        <h1>Practice</h1>
        <button
          type="button"
          id="filter-toggle"
          class="filter-toggle"
          aria-label="Open filters"
          aria-expanded="false"
          aria-controls="practice-filters-panel"
        >
          <svg class="filter-toggle__icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M4 6h16v2H4V6zm3 5h10v2H7v-2zm4 5h2v2h-2v-2z"/>
          </svg>
        </button>
      </div>
      <p class="instructions" id="instructions">Type on the text below. Use the filter control to change words.</p>
    </header>

    <div id="practice-filters-panel" class="practice-filters-panel" hidden>
      {{> practice_settings }}
    </div>

    <div class="practice-content" id="practice-content">
      <section class="practice-stage" id="practice-stage">
        <div class="live-stats live-stats--hidden" id="live-stats" aria-live="polite">
          <div class="live-stats__item"><span class="live-stats__label">Time</span><strong id="live-time">0:00</strong></div>
          <div class="live-stats__item"><span class="live-stats__label">WPM</span><strong id="live-wpm">0</strong></div>
          <div class="live-stats__item"><span class="live-stats__label">Accuracy</span><strong id="live-accuracy">100</strong>%</div>
        </div>

        <div class="quote-viewport" id="quote-viewport" aria-label="Words to type">
          <div id="typing-surface" class="typing-surface typing-surface--preview" tabindex="0" aria-label="Typing area">
            <div id="quote" class="quote-track quote-track--idle"></div>
          </div>
        </div>

        <p id="message" class="message" role="status"></p>
      </section>

      <div class="practice-actions">
        <button id="start" type="button" class="btn-primary">
          Start test<span class="shortcut-hint shortcut-hint--btn" aria-label="Shortcut Control Enter">Ctrl+Enter</span>
        </button>
        <button id="restart" type="button" class="btn-secondary" hidden>Try again</button>
      </div>
    </div>
  </main>

  <script src="/js/core/http.js"></script>
  <script src="/js/core/metrics.js"></script>
  <script src="/js/core/stream-content.js"></script>
  <script src="/js/components/practice-settings.js"></script>
  <script src="/js/core/keyboard-helpers.js"></script>
  <script src="/js/app-nav.js"></script>
  <script src="/js/keyboard-shortcuts.js"></script>
  <script src="/js/typing-test.js"></script>
</body>
</html>
